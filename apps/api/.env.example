DATABASE_URL="postgresql://postgres:postgres@localhost:5432/overloaded"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=overloaded
JWT_SECRET=
JWT_AUD=
ANTHROPIC_API_KEY=

# The SPA's origin — used for CORS (credentialed requests can't use a
# wildcard origin) and for where /auth/google/callback redirects the
# browser back to once Google sign-in completes.
FRONTEND_URL='http://localhost:3000'

# Google OAuth 2.0 (authorization code grant) — from the Google Cloud Console
# credentials page. GOOGLE_REDIRECT_URI points at THIS API (not the frontend)
# and must exactly match an "Authorized redirect URI" configured on that
# OAuth client, since Google redirects the browser straight to it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI='http://localhost:3001/api/v1/auth/google/callback'
